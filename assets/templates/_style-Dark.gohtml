:root {
	--bg: #0E1617;
	--surface: #152224;
	--line: #233537;
	--line-soft: #1A2A2C;
	--control: #587173;
	--text: #E7EFEE;
	--muted: #9DB3B1;
	--accent: #5FD4C3;
	--on-accent: #062221;
	--accent-soft: #173234;
	--accent-ink: #5FD4C3;
	--danger: #FF8A80;
	--select: #1F5A55;
	--shell: #0A1F20;
	--shell-text: #E7EFEE;
	--shell-muted: #9DB3B1;
	--shell-soft: #B9CCCA;
	--shell-hover: #12292B;
	--shell-active: #173234;
	--shell-line: #233537;
	--shell-accent: #5FD4C3;
	--shell-on-accent: #062221;
	color-scheme: dark;
}
