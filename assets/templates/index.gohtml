<!doctype html>
<html lang="{{lang}}">
	<head>
		{{render "_head" $}}
		<title>{{tr "titleprefix"}}{{tr "nav_index"}}</title>
		<style>
			.page-head {
				display: flex;
				flex-wrap: wrap;
				align-items: flex-end;
				justify-content: space-between;
				gap: 16px;
				margin-bottom: 8px;
			}
			.page-head p {
				margin: 0;
				color: var(--muted);
				font-size: 16px;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
			}
			noscript {
				display: block;
				margin: 16px 0;
				padding: 12px 16px;
				border-radius: var(--r);
				background: var(--surface);
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 16px;
				margin: 36px 0 16px;
			}
			.section-head h2 {
				margin: 0;
			}
			.section-head a {
				font-size: 16px;
				font-weight: 600;
			}
			.albums {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
				gap: 24px;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.albums a {
				display: flex;
				flex-direction: column;
				gap: 10px;
				color: var(--text);
				text-decoration: none;
			}
			.albums a:hover b {
				text-decoration: underline;
			}
			.cover {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100%;
				aspect-ratio: 1 / 1;
				border-radius: var(--radius, 10px);
				background: var(--surface);
				color: var(--muted);
				object-fit: cover;
			}
			.cover .icon {
				width: 40%;
				height: 40%;
				stroke-width: 1.2;
			}
			.meta {
				display: flex;
				flex-direction: column;
				min-width: 0;
				line-height: 1.35;
			}
			.meta b, .meta span {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.meta b {
				font-size: 16px;
				font-weight: 600;
			}
			.meta span {
				font-size: 15px;
				color: var(--muted);
			}
			.played {
				width: 100%;
				font-size: 16px;
			}
			.played th {
				padding: 0 12px 10px;
				border-bottom: 1px solid var(--line);
			}
			.played td {
				height: 52px;
				padding: 0 12px;
				border-bottom: 1px solid var(--line-soft);
				color: var(--muted);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: 0;
			}
			.played td.title {
				color: var(--text);
				font-weight: 500;
			}
			.played .time {
				width: 64px;
				text-align: right;
			}
			.played .fmt-col {
				width: 110px;
			}
			.fmt {
				display: inline-block;
				padding: 2px 8px;
				border-radius: 6px;
				border-radius: var(--radius, 6px);
				background: var(--surface);
				color: var(--muted);
				font-size: 13px;
				font-weight: 600;
			}
			.empty {
				margin-top: 32px;
				padding: 32px;
				border: 1px solid var(--line);
				border-radius: var(--r);
				background: var(--surface);
			}
			.empty h2 {
				margin-top: 0;
			}
			@media screen and (max-width: 767px) {
				.albums {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 18px 14px;
				}
				.played .album, .played .fmt-col {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		{{render "_nav" $}}
		<main>
			<header class="page-head">
				<div>
					<h1>{{tr "nav_index"}}</h1>
					{{if $.Home.Tracks}}
						<p>{{tc "home_tracks" $.Home.Tracks}} · {{tc "home_albums" $.Home.Albums}} · {{tc "home_artists" $.Home.Artists}}</p>
					{{end}}
				</div>
				{{if $.Home.Tracks}}
					<div class="actions">
						<a class="btn btn-primary" href="/music/albums">{{tr "home_open"}}</a>
						<a class="btn" href="/upload">{{tr "nav_upload_music"}}</a>
					</div>
				{{end}}
			</header>
			<noscript>{{tr "noscript"}}</noscript>


			{{if (eq $.Home.Tracks 0)}}
				<section class="empty" aria-labelledby="empty-title">
					<h2 id="empty-title">{{tr "home_empty"}}</h2>
					<p>{{tr "home_empty_body"}}</p>
					<div class="actions">
						<a class="btn btn-primary" href="/upload">{{render "_icon" "plus"}}{{tr "nav_upload_music"}}</a>
						<a class="btn" href="/subsonic">{{tr "home_subsonic"}}</a>
					</div>
				</section>
			{{else}}
				<section aria-labelledby="recent">
					<div class="section-head">
						<h2 id="recent">{{tr "home_recent"}}</h2>
						<a href="/music/albums">{{tr "home_all_albums"}}</a>
					</div>
					<ul class="albums">
						{{range $.Home.Recent}}
							<li>
								<a href="/music/albums#{{.AlbumCode}}">
									{{if .Picture.ID}}
										<img class="cover" src="{{.Picture.URL}}" alt="" loading="lazy">
									{{else}}
										<span class="cover">{{render "_icon" "albums"}}</span>
									{{end}}
									<span class="meta">
										{{with .Info.Album}}<b>{{.}}</b>{{else}}<b class="unknown">{{tr "unknownalbum"}}</b>{{end}}
										<span>{{with (or .Info.AlbumArtist .Info.Artist)}}{{.}}{{else}}{{tr "unknownartist"}}{{end}}</span>
									</span>
								</a>
							</li>
						{{end}}
					</ul>
				</section>

				{{if $.Home.Played}}
					<section aria-labelledby="played">
						<div class="section-head">
							<h2 id="played">{{tr "home_played"}}</h2>
							<a href="/music/">{{tr "home_all_tracks"}}</a>
						</div>
						<table class="played">
							<thead>
								<tr>
									<th scope="col">{{tr "title"}}</th>
									<th scope="col">{{tr "artist"}}</th>
									<th scope="col" class="album">{{tr "album"}}</th>
									<th scope="col" class="fmt-col">{{tr "format"}}</th>
									<th scope="col" class="time">{{tr "time"}}</th>
								</tr>
							</thead>
							<tbody>
								{{range $.Home.Played}}
									<tr>
										<td class="title">{{with (or .Info.Title .Filename)}}{{.}}{{end}}</td>
										<td>{{or .Info.Artist .Info.AlbumArtist}}</td>
										<td class="album">{{.Info.Album}}</td>
										<td class="fmt-col">{{with .Filetype}}<span class="fmt">{{.}}</span>{{end}}</td>
										<td class="time figures">{{if .Duration}}{{mmss .Duration}}{{end}}</td>
									</tr>
								{{end}}
							</tbody>
						</table>
					</section>
				{{end}}
			{{end}}
		</main>
	</body>
</html>
