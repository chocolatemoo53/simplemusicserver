<svg class="icon icon-{{.}}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
{{- if eq . "logo"}}<circle cx="10.3" cy="16" r="4"/><path d="M14.3 16V4c2.5.8 4.2 2.6 4.4 5.6"/><circle cx="10.3" cy="16" r="1.2" fill="currentColor" stroke="none"/>
{{- else if eq . "unlock"}}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-2"/>
{{- else if eq . "plus"}}<path d="M12 5v14M5 12h14"/>
{{- else if eq . "home"}}<path d="M4 11 12 4l8 7v9h-5v-6H9v6H4v-9Z"/>
{{- else if eq . "tracks"}}<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>
{{- else if eq . "albums"}}<rect x="4" y="4" width="16" height="16" rx="3"/><circle cx="12" cy="12" r="3"/>
{{- else if eq . "playlist"}}<path d="M4 6h16M4 12h10M4 18h7M17 14v7l5-3.5L17 14Z"/>
{{- else if eq . "sync"}}<path d="M20 12a8 8 0 0 1-14 5.3M4 12a8 8 0 0 1 14-5.3"/><path d="M18 3v4h-4M6 21v-4h4"/>
{{- else if eq . "jam"}}<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.5a3 3 0 0 1 0 5M18 14.5a6 6 0 0 1 3 5.5"/>
{{- else if eq . "phone"}}<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>
{{- else if eq . "settings"}}<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>

{{- else if eq . "admin"}}<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/>
{{- else if eq . "play"}}<path d="M7 5v14l12-7L7 5Z"/>
{{- else if eq . "pause"}}<path d="M9 6v12M15 6v12"/>
{{- else if eq . "resume"}}<path d="M4 5v14l8-7-8-7ZM13 5v14l8-7-8-7Z"/>
{{- else if eq . "prev"}}<path d="M18 6 9 12l9 6V6Z"/><path d="M6 6v12"/>
{{- else if eq . "next"}}<path d="m6 6 9 6-9 6V6Z"/><path d="M18 6v12"/>
{{- else if eq . "shuffle"}}<path d="M16 4h4v4"/><path d="M4 20 20 4"/><path d="M16 20h4v-4"/><path d="m14 14 6 6"/><path d="m4 4 5 5"/>
{{- else if eq . "repeat"}}<path d="m17 3 3 3-3 3"/><path d="M4 12V9a3 3 0 0 1 3-3h13"/><path d="m7 21-3-3 3-3"/><path d="M20 12v3a3 3 0 0 1-3 3H4"/>
{{- else if eq . "repeat-one"}}<path d="m17 3 3 3-3 3"/><path d="M4 12V9a3 3 0 0 1 3-3h13"/><path d="m7 21-3-3 3-3"/><path d="M20 12v3a3 3 0 0 1-3 3H4"/><path d="M11 10h1v5"/>
{{- else if eq . "download"}}<path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/>
{{- else if eq . "edit"}}<path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13 7 4 4"/>
{{- else if eq . "delete"}}<path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/>
{{- else if eq . "volume"}}<path d="M4 9v6h4l5 4V5L8 9H4Z"/><path d="M16.5 8.5a5 5 0 0 1 0 7"/>
{{- else if eq . "search"}}<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
{{- else if eq . "lyrics"}}<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/>
{{- else if eq . "upload"}}<path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M5 20h14"/>
{{- else if eq . "folder"}}<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2h8.5A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Z"/>
{{- else if eq . "check"}}<path d="m5 12 5 5 9-10"/>
{{- else if eq . "alert"}}<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5"/><path d="M12 16.5h.01"/>
{{- else if eq . "close"}}<path d="M6 6l12 12M18 6 6 18"/>
{{- end -}}
</svg>
