<!doctype html>
<html>
	<head>
		{{render "_head" $}}
		<title>{{tr "titleprefix"}}admin</title>
		<style>
			table.admin {
				border-spacing: 0;
			}
			table.admin td, table.admin th {
				padding: 0.2em 0.75em 0.2em 0;
				text-align: left;
			}
		</style>
	</head>
	<body>
		{{render "_nav" $}}
		<main>
			{{with $.Notice}}<p><b>{{. | ucfirst}}</b></p>{{end}}
			<h2>Overview</h2>
			<table class="admin">
				<tr><td>Users:</td><td>{{$.Totals.Users}}</td></tr>
				<tr><td>Storage:</td><td>{{$.Totals.Usage | bytesize}} in {{$.Totals.Tracks}} tracks</td></tr>

				{{if $.Replicated}}
				<tr><td>Replica:</td><td>{{$.Replicas.Copied}} copied, {{$.Replicas.Pending}} waiting to copy, {{$.Replicas.Erasing}} waiting to be erased{{if $.Replicas.Failing}}, <span class="error-msg">{{$.Replicas.Failing}} failing (see the server log)</span>{{end}}</td></tr>
				{{else}}
				<tr><td>Replica:</td><td>Not configured. Files exist in one place only.</td></tr>
				{{end}}
			</table>


			<h2>Users</h2>
			<div class="table-scroll">
			<table class="admin">
				<tr>
					<th>ID</th>
					<th>E-mail</th>
					<th>Usage</th>
					<th>Tracks</th>

					<th>Registered</th>
					<th>Last active</th>
				</tr>
				{{range $.Users}}
				<tr>
					<td>{{.ID}}</td>
					<td><a href="/admin/user/{{.ID}}">{{.Email}}</a></td>
					<td>{{.Usage | bytesize}}</td>
					<td>{{.Tracks}}</td>

					<td>{{.Regdate | timestamp}}</td>
					<td>{{.LastMod | timestamp}}</td>
				</tr>
				{{end}}
			</table>
			</div>
		</main>
	</body>
</html>
