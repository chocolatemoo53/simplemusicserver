<!doctype html>
<html>
	<head>
		{{render "_head" $}}
		<title>{{tr "titleprefix"}}{{tr "checkout_title"}}</title>
	</head>
	<body>
		{{render "_nav" $}}
		<main>
			<h2>{{tr "checkout_thanks"}}</h2>
			<p>{{tr "checkout_explain"}}</p>
			<p>{{tr "buy_balance"}}: <b>{{$.User.Balance}}</b></p>
			<p><a href="/buy/">{{tr "checkout_back"}}</a></p>
		</main>
	</body>
</html>
