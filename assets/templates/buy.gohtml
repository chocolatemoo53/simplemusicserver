<!doctype html>
<html>
	<head>
		{{render "_head" $}}
		<title>{{tr "titleprefix"}}{{tr "buy_title"}}</title>
	</head>
	<style>
		table.billing {
			border-spacing: 0;
		}
		table.billing td {
			padding: 0.25em 0.75em 0.25em 0;
		}
		.presets button {
			min-width: 4em;
		}
		.manual-pay {
			white-space: pre-line;
		}
		summary {
			cursor: pointer;
			font-weight: bold;
		}
		details > p {
			padding-left: 0.5em;
		}
	</style>
	<body>
		{{render "_nav" $}}
		<main>
			<h2>{{tr "buy_title"}}</h2>
			<p>{{tr "buy_intro"}}</p>
			<ul>
				<li>{{tr "buy_free" ($.Pricing.FreeBytes | bytesize)}}</li>
				<li>{{tr "buy_rate" $.Pricing.PerGBMonth}}</li>
				<li>{{tr "buy_example" (monthlycost 200)}}</li>
			</ul>

			{{if loggedin}}
				{{render "_standing" $}}
				<p class="error-msg">{{$.ErrorMsg | ucfirst}}</p>
				<table class="billing">
					<tr><td>{{tr "settings_usage"}}:</td><td>{{$.User.Usage | bytesize}}</td></tr>
					<tr><td>{{tr "buy_balance"}}:</td><td><b>{{$.User.Balance}}</b></td></tr>
					<tr><td>{{tr "buy_monthly"}}:</td><td>{{$.User.MonthlyCost}}</td></tr>
					{{with paiduntil $.User}}
						<tr><td>{{tr "buy_lasts"}}:</td><td>{{. | date}}</td></tr>
					{{end}}
				</table>

				{{if payment}}
					<h3>{{tr "buy_add"}}</h3>
					<form action="/buy/checkout" method="POST" class="presets">
						{{range $.Presets}}
							<button type="submit" name="amount" value="{{.}}">${{.}}</button>
						{{end}}
					</form>
					<form action="/buy/checkout" method="POST">
						<label for="amount">{{tr "buy_amount"}}:</label>
						<input type="text" inputmode="decimal" id="amount" name="amount" placeholder="20.00" size="8" required>
						<input type="submit" value='{{tr "buy_pay"}}'>
					</form>
					<p><small>{{tr "buy_explain"}}</small></p>

					<h3 id="refunds">{{tr "refund_title"}}</h3>
					<p>{{tr "refund_explain" $.Pricing.RefundDays}}</p>
					{{if $.Refundable}}
						<form action="/buy/refund" method="POST">
							<table class="billing">
								<tr>
									<td><label for="refund-amount">{{tr "refund_amount"}}:</label></td>
									<td><input type="text" inputmode="decimal" id="refund-amount" name="amount" value="{{formatusd $.Refundable}}" size="8" required> ({{tr "refund_max" $.Refundable}})</td>
								</tr>
								<tr>
									<td><label for="refund-password">{{tr "password"}}:</label></td>
									<td><input type="password" id="refund-password" name="password" autocomplete="current-password" required></td>
								</tr>
								<tr>
									<td></td>
									<td><input type="submit" value='{{tr "refund_button"}}'></td>
								</tr>
							</table>
						</form>
						{{if $.Pricing.RefundFeePct}}<p><small>{{tr "refund_fee" $.Pricing.RefundFeePct}}</small></p>{{end}}
						{{if $.User.MonthlyCost}}<p><small>{{tr "refund_warn"}}</small></p>{{end}}
					{{else}}
						<p>{{tr "refund_none"}}</p>
					{{end}}
					{{if $.Refunds}}
						<table class="billing">
							{{range $.Refunds}}
								<tr>
									<td>{{.At | date}}</td>
									<td>{{.Amount}}</td>
									<td>{{tr (print "refund_status_" .Status)}}</td>
									<td>{{if .Link}}<a href="{{.Link}}" target="_blank" rel="noopener noreferrer">{{tr "refund_claim"}}</a>{{end}}</td>
								</tr>
							{{end}}
						</table>
					{{end}}
				{{else if manualpay}}
					<h3>{{tr "buy_add"}}</h3>
					<p class="manual-pay">{{manualpay}}</p>
					<p>{{tr "buy_manual_reference" $.User.ID}}</p>
					<p><small>{{tr "buy_manual_explain"}}</small></p>
				{{else}}
					<p>{{tr "buy_disabled"}}</p>
				{{end}}

				{{if $.Ledger}}
					<h3>{{tr "buy_history"}}</h3>
					<table class="billing">
						{{range $.Ledger}}
							<tr>
								<td>{{.At | date}}</td>
								<td>{{tr (print "ledger_" .Kind)}}</td>
								<td>{{.Amount}}</td>
							</tr>
						{{end}}
					</table>
				{{end}}
			{{else}}
				<br>
				<h3>{{tr "buy_pitch"}}</h3>
				<p><a href="/register">{{tr "nav_register"}}</a> / <a href="/login">{{tr "nav_login"}}</a></p>
			{{end}}

			<br>
			<div>
				<h3>Q&amp;A</h3>
				<details>
					<summary>{{tr "qa_what"}}</summary>
					<p>{{tr "qa_what_a"}}</p>
				</details>
				<details>
					<summary>{{tr "qa_formats"}}</summary>
					<p>{{tr "qa_formats_a" (tr "supportedformats")}}</p>
				</details>
				<details>
					<summary>{{tr "qa_privacy"}}</summary>
					<p>{{tr "qa_privacy_a"}}</p>
				</details>
				<details>
					<summary>{{tr "qa_lapse"}}</summary>
					<p>{{tr "qa_lapse_a" $.Pricing.GraceDays $.Pricing.LockDays}}</p>
				</details>
				<details>
					<summary>{{tr "qa_reencode"}}</summary>
					<p>{{tr "qa_reencode_a"}}</p>
				</details>
			</div>
		</main>
		{{render "_foot" $}}
	</body>
</html>
