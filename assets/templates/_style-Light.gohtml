:root {
	--bg: #FFFFFF;
	--surface: #F2F6F6;
	--line: #DCE5E5;
	--line-soft: #EDF2F2;
	--control: #7D8F8E;
	--text: #102222;
	--muted: #4E6463;
	--accent: #0B6E69;
	--on-accent: #FFFFFF;
	--accent-soft: #E3F3F1;
	--accent-ink: #0B5A56;
	--danger: #B42318;
	--select: #BFEDE6;
	--shell: #0F3D3E;
	--shell-text: #E6F2F1;
	--shell-muted: #9FC3C0;
	--shell-soft: #C4DEDB;
	--shell-hover: #174748;
	--shell-active: #1C5557;
	--shell-line: #2A6466;
	--shell-accent: #6FE0CF;
	--shell-on-accent: #062221;
	color-scheme: light;
}
